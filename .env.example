# Copy this file to .env and fill in your BrightHR Lite sandbox login
# (the account created in Step 1 of the task, or the fallback login in the task brief).
# .env is git-ignored, so real credentials never reach the repository.
# In CI the same values come from GitHub Actions secrets.
BRIGHTHR_EMAIL=your-sandbox-email@example.com
BRIGHTHR_PASSWORD=your-sandbox-password
# Optional: override the app URL (defaults to the BrightHR sandbox)
# BASE_URL=https://sandbox-app.brighthr.com
